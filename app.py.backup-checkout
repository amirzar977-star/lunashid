def get_cart():
    return session.get("cart", {})


def save_cart(cart):
    session["cart"] = cart
    session.modified = True


def cart_items():
    cart = get_cart()

    if not cart:
        return [], 0, 0

    ids = [int(x) for x in cart.keys()]

    placeholders = ",".join(["?"] * len(ids))

    conn = db()
    products = conn.execute(
        f"SELECT * FROM products WHERE id IN ({placeholders})",
        ids
    ).fetchall()
    conn.close()

    result = []
    total = 0
    count = 0

    for product in products:
        quantity = int(cart.get(str(product["id"]), 0))

        if quantity <= 0:
            continue

        subtotal = product["price"] * quantity

        result.append({
            "product": product,
            "quantity": quantity,
            "subtotal": subtotal
        })

        total += subtotal
        count += quantity

    return result, total, count


@app.context_processor
def inject_site():
    items, total, count = cart_items()

    return {
        "site": get_settings(),
        "cart_count": count,
        "cart_total": total
    }


