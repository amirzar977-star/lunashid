# Base44 sandbox dev image.
#
# Dependencies only — application source is bind-mounted at /workspace by
# docker-compose.base44.yml so edits are picked up by the live dev server.
FROM python:3.12-slim

ENV PYTHONUNBUFFERED=1 \
    PYTHONDONTWRITEBYTECODE=1 \
    PIP_DISABLE_PIP_VERSION_CHECK=1

WORKDIR /workspace

# Install pinned dependencies from the lockfile-ish requirements file.
COPY requirements.txt /tmp/requirements.txt
RUN pip install --no-cache-dir -r /tmp/requirements.txt

EXPOSE 3000

CMD ["python", "-c", "print('base44 dev image: dependencies installed')"]
