        </h2>

    </div>


    {% if product_gallery and product_gallery|length > 0 %}

        <div class="product-gallery-grid">

            {% for image in product_gallery %}

                <div
                    class="product-gallery-card"
                    onclick="openGalleryImage(
                        '{{ url_for(
                            'static',
                            filename='uploads/products/gallery/' ~ image.filename
                        ) }}'
                    )"
                >

                    <img
                        src="{{ url_for(
                            'static',
                            filename='uploads/products/gallery/' ~ image.filename
                        ) }}"
                        alt="{{ product.name }}"
                        loading="lazy"
                    >

                </div>

            {% endfor %}

        </div>

    {% else %}

        <div
            style="
                padding:35px;
                text-align:center;
                border-radius:24px;
                background:rgba(255,255,255,.12);
                border:1px solid rgba(255,255,255,.28);
                color:#888;
            "
        >
            تصاویر بیشتری برای این محصول ثبت نشده است.
        </div>

    {% endif %}

</section>


<!-- GALLERY VIEWER -->

<div
    id="galleryViewer"
    class="gallery-viewer"
    onclick="closeGalleryImage(event)"
>

    <button
        type="button"
        class="gallery-viewer-close"
        onclick="closeGalleryImage()"
    >
        ×
    </button>

    <img
        id="galleryViewerImage"
        src=""
        alt=""
    >

</div>


<script>

function openGalleryImage(src){

    const viewer =
        document.getElementById(
            "galleryViewer"
        );

    const image =
        document.getElementById(
            "galleryViewerImage"
        );

    image.src = src;

    viewer.classList.add("open");

    document.body.style.overflow = "hidden";
}


function closeGalleryImage(event){

    if(
        event &&
        event.target &&
        event.target.id === "galleryViewerImage"
    ){
        return;
    }

    const viewer =
        document.getElementById(
            "galleryViewer"
        );

    viewer.classList.remove("open");

    document.body.style.overflow = "";
}


document.addEventListener(
    "keydown",
    function(event){

        if(event.key === "Escape"){

            closeGalleryImage();

        }

    }
);

</script>

{% endblock %}









