<style>
.product-detail{
    max-width:1200px;
    margin:70px auto;
    padding:25px;
}

.product-detail-grid{
    display:grid;
    grid-template-columns:1.1fr .9fr;
    gap:55px;
    align-items:center;
}

.product-photo{
    min-height:520px;
    border-radius:35px;
    overflow:hidden;
    border:1px solid rgba(255,255,255,.28);
    background:rgba(255,255,255,.025);
    backdrop-filter:blur(10px) saturate(160%);
    box-shadow:0 30px 80px rgba(0,0,0,.08);
}

.product-photo img{
    width:100%;
    height:520px;
    object-fit:cover;
    display:block;
}

.product-placeholder{
    height:520px;
    display:flex;
    align-items:center;
    justify-content:center;
    color:#777;
}

.product-info{
    direction:rtl;
    text-align:right;
}

.product-category{
    display:inline-block;
    padding:8px 15px;
    border-radius:999px;
    background:rgba(169,29,58,.08);
    color:#A91D3A;
    margin-bottom:18px;
}

.product-info h1{
    font-size:46px;
    margin:0 0 20px;
}

.product-description{
    color:#666;
    line-height:2.2;
    font-size:17px;
}

.product-price{
    font-size:30px;
    font-weight:800;
    margin:30px 0;
    color:#A91D3A;
}

.quantity-box{
    display:flex;
    align-items:center;
    gap:10px;
    margin-bottom:20px;
    direction:rtl;
}

.quantity-box input{
    width:80px;
    padding:15px;
    text-align:center;
    border-radius:15px;
    border:1px solid rgba(0,0,0,.1);
    background:rgba(255,255,255,.4);
}

.add-cart{
    width:100%;
    border:0;
    padding:18px;
    border-radius:18px;
    background:#A91D3A;
    color:white;
    font-family:inherit;
    font-size:17px;
    cursor:pointer;
    transition:.25s;
}

.add-cart:hover{
    transform:translateY(-3px);
    box-shadow:0 15px 35px rgba(169,29,58,.2);
}

.back-shop{
    display:inline-block;
    margin-top:18px;
    color:#555;
    text-decoration:none;
}

.related{
    margin-top:100px;
    direction:rtl;
}

.related h2{
    margin-bottom:25px;
}

.related-grid{
    display:grid;
    grid-template-columns:repeat(4,1fr);
    gap:20px;
}

.related-card{
    text-decoration:none;
    color:inherit;
    border-radius:25px;
    overflow:hidden;
    border:1px solid rgba(255,255,255,.25);
    background:rgba(255,255,255,.025);
    backdrop-filter:blur(10px);
}

.related-card img{
    width:100%;
    height:210px;
    object-fit:cover;
}

.related-card-info{
    padding:15px;
}

.related-card-info strong{
    display:block;
    margin-bottom:8px;
}

@media(max-width:800px){
    .product-detail-grid{
        grid-template-columns:1fr;
        gap:30px;
    }

    .product-info h1{
        font-size:34px;
    }

    .product-photo,
    .product-photo img{
        min-height:350px;
        height:350px;
    }

    .related-grid{
        grid-template-columns:repeat(2,1fr);
    }
}
</style>

<section class="product-detail">

    <div class="product-detail-grid">

        <div class="product-photo">

            {% if product.image %}

            <img
                src="{{ url_for('static', filename='uploads/products/' ~ product.image) }}"
                alt="{{ product.name }}"
            >

            {% else %}

            <div class="product-placeholder">
                تصویر محصول
            </div>

            {% endif %}

        </div>

        <div class="product-info">

            {% if product.category %}
            <span class="product-category">
                {{ product.category }}
            </span>
            {% endif %}

            <h1>{{ product.name }}</h1>

            <div class="product-description">
                {{ product.description }}
            </div>

            <div class="product-price">
                {{ "{:,}".format(product.price) }} تومان
            </div>

            <form
                
                
             onsubmit="event.preventDefault(); addToMiniCart({{ product.id }});">

                <div class="quantity-box">

                    <label>تعداد</label>

                    <input
                        type="number"
                        name="quantity"
                        value="1"
                        min="1"
                        max="99"
                    >

                </div>

                <input
                    type="hidden"
                    name="next"
                    value="{{ url_for('cart') }}"
                >

                <button class="add-cart" type="submit" type="button" onclick="addToMiniCart({{ product.id }});">افزودن به سبد</button>

            </form>

            <a class="back-shop" href="{{ url_for('products') }}">
                ← بازگشت به مجموعه محصولات
            </a>

        </div>

    </div>


    {% if related %}

    <section class="related">

        <div class="gallery-count" style="color:#777;font-size:12px;margin-top:7px;">{{ product_gallery|length }} تصویر</div><h2>محصولات مشابه</h2>

        <div class="related-grid">

            {% for item in related %}

            <a
                class="related-card"
                href="{{ url_for('product', product_id=item.id) }}"
            >

                {% if item.image %}

                <img
                    src="{{ url_for('static', filename='uploads/products/' ~ item.image) }}"
                    alt="{{ item.name }}"
                >

                {% endif %}

                <div class="related-card-info">

                    <strong>{{ item.name }}</strong>

                    <span>
                        {{ "{:,}".format(item.price) }} تومان
                    </span>

                </div>

            </a>

            {% endfor %}

        </div>

    </section>

    {% endif %}

</section>


