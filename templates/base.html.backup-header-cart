<!DOCTYPE html>
<html lang="fa" dir="rtl">

<head>

<meta charset="UTF-8">

<meta name="viewport"
      content="width=device-width,initial-scale=1">

<title>{{ site.site_name }}</title>

<link rel="stylesheet"
      href="{{ url_for('static',filename='css/style.css') }}">

{% if site.background %}
<style>
.background{
    background-image:
        linear-gradient(
            rgba(247,243,234,.10),
            rgba(247,243,234,.10)
        ),
        url("{{ url_for('static',filename='uploads/backgrounds/' ~ site.background) }}");

    background-size:cover;
    background-position:center;
    background-repeat:no-repeat;
    background-attachment:fixed;
}
</style>
{% endif %}

</head>

<body>

<div class="background"></div>

<header class="glass header">

    <a class="brand" href="{{ url_for('home') }}">

        <span class="brand-mark">ل</span>

        <span>
            <b>{{ site.site_name }}</b>
            <small>ceramic studio</small>
        </span>

    </a>

    <nav>

        <a href="{{ url_for('home') }}">
            خانه
        </a>

        <a href="{{ url_for('products') }}">
            مجموعه
        </a>

        <a href="{{ url_for('about') }}">
            درباره ما
        </a>

        <a href="{{ url_for('cart') }}">
            سبد خرید
        </a>

    <a href="{{ url_for('track_order') }}">
    پیگیری سفارش
</a>
</nav>

    <a class="mini-button"
       href="{{ url_for('products') }}">
        مشاهده مجموعه
    </a>

</header>

{% with messages=get_flashed_messages(with_categories=true) %}

{% for category,message in messages %}

<div class="toast">
    {{ message }}
</div>

{% endfor %}

{% endwith %}

{% block content %}{% endblock %}

<footer class="footer glass">

    <div>
        <b>{{ site.site_name }}</b>
        <p>{{ site.site_description }}</p>
    </div>

    <span>
        ساخته‌شده با دست · با عشق
    </span>

</footer>

<script src="{{ url_for('static',filename='js/app.js') }}"></script>

{% include "mini_cart.html" %}`r`n</body>
</html>








