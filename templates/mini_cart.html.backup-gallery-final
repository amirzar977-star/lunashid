<!-- MINI CART -->

<div
    id="miniCartOverlay"
    class="mini-cart-overlay"
    onclick="closeMiniCart(event)"
>
</div>


<aside
    id="miniCart"
    class="mini-cart"
>

    <div class="mini-cart-header">

        <div>

            <span>
                YOUR CART
            </span>

            <h2>
                سبد خرید
            </h2>

        </div>

        <button
            type="button"
            onclick="closeMiniCart()"
            class="mini-cart-close"
        >
            ×
        </button>

    </div>


    <div
        id="miniCartItems"
        class="mini-cart-items"
    >
        <div class="mini-cart-empty">
            سبد خرید خالی است.
        </div>
    </div>


    <div class="mini-cart-footer">

        <div class="mini-cart-total">

            <span>
                مجموع
            </span>

            <strong id="miniCartTotal">
                0 تومان
            </strong>

        </div>

        <a
            href="{{ url_for('cart') }}"
            class="mini-cart-checkout"
        >
            مشاهده سبد خرید
        </a>

    </div>

</aside>


<style>

.mini-cart-overlay{
    position:fixed;
    inset:0;
    background:rgba(20,25,20,.16);
    backdrop-filter:blur(3px);
    z-index:9997;
    opacity:0;
    pointer-events:none;
    transition:.3s;
}

.mini-cart-overlay.open{
    opacity:1;
    pointer-events:auto;
}

.mini-cart{
    position:fixed;
    top:0;
    right:0;
    width:min(430px,92vw);
    height:100vh;
    box-sizing:border-box;
    z-index:9998;

    display:flex;
    flex-direction:column;

    background:rgba(255,255,255,.16);
    border-left:1px solid rgba(255,255,255,.4);

    backdrop-filter:
        blur(24px)
        saturate(170%);

    transform:translateX(105%);
    transition:transform .38s cubic-bezier(.2,.8,.2,1);

    direction:rtl;
}

.mini-cart.open{
    transform:translateX(0);
}

.mini-cart-header{
    display:flex;
    justify-content:space-between;
    align-items:center;
    padding:28px;
    border-bottom:1px solid rgba(0,0,0,.06);
}

.mini-cart-header span{
    font-size:10px;
    letter-spacing:3px;
    color:#A91D3A;
}

.mini-cart-header h2{
    margin:7px 0 0;
}

.mini-cart-close{
    width:42px;
    height:42px;
    border:0;
    border-radius:50%;
    background:rgba(255,255,255,.3);
    font-size:25px;
    cursor:pointer;
}

.mini-cart-items{
    flex:1;
    overflow-y:auto;
    padding:20px;
}

.mini-cart-empty{
    height:100%;
    display:flex;
    align-items:center;
    justify-content:center;
    color:#888;
}

.mini-cart-item{
    display:grid;
    grid-template-columns:75px 1fr auto;
    gap:13px;
    align-items:center;

    padding:13px;
    margin-bottom:12px;

    border-radius:18px;

    background:rgba(255,255,255,.16);
    border:1px solid rgba(255,255,255,.3);
}

.mini-cart-item img{
    width:75px;
    height:75px;
    object-fit:cover;
    border-radius:14px;
}

.mini-cart-item-name{
    font-weight:700;
    line-height:1.5;
}

.mini-cart-item-meta{
    margin-top:5px;
    color:#888;
    font-size:12px;
}

.mini-cart-item-price{
    color:#A91D3A;
    font-size:13px;
    font-weight:800;
    white-space:nowrap;
}

.mini-cart-footer{
    padding:22px;
    border-top:1px solid rgba(0,0,0,.06);
}

.mini-cart-total{
    display:flex;
    justify-content:space-between;
    align-items:center;
    margin-bottom:15px;
}

.mini-cart-total strong{
    color:#A91D3A;
    font-size:20px;
}

.mini-cart-checkout{
    display:block;
    text-align:center;
    text-decoration:none;
    padding:15px;
    border-radius:16px;
    background:#A91D3A;
    color:white;
}

.mini-cart-toast{
    position:fixed;
    left:50%;
    bottom:25px;
    transform:translateX(-50%) translateY(20px);

    z-index:10001;

    padding:13px 20px;
    border-radius:999px;

    background:rgba(255,255,255,.55);
    backdrop-filter:blur(15px);

    border:1px solid rgba(255,255,255,.5);

    opacity:0;
    pointer-events:none;

    transition:.3s;
}

.mini-cart-toast.show{
    opacity:1;
    transform:translateX(-50%) translateY(0);
}

@media(max-width:500px){

    .mini-cart{
        width:100%;
    }

}

</style>


<div
    id="miniCartToast"
    class="mini-cart-toast"
>
    محصول به سبد اضافه شد
</div>


<script>

function formatMoney(value){

    return Number(value || 0)
        .toLocaleString("fa-IR") + " تومان";

}


async function refreshMiniCart(){

    try{

        const response =
            await fetch("/api/cart");

        const data =
            await response.json();

        const container =
            document.getElementById(
                "miniCartItems"
            );

        const total =
            document.getElementById(
                "miniCartTotal"
            );

        if(!data.items.length){

            container.innerHTML = `
                <div class="mini-cart-empty">
                    سبد خرید خالی است.
                </div>
            `;

        }else{

            container.innerHTML =
                data.items.map(item => {

                    let image = "";

                    if(item.image){

                        image =
                            `/static/uploads/products/${item.image}`;

                    }else{

                        image =
                            `/static/uploads/products/no-image.svg`;

                    }

                    return `
                        <div class="mini-cart-item">

                            <img
                                src="${image}"
                                onerror="this.style.opacity='.2'"
                            >

                            <div>

                                <div class="mini-cart-item-name">
                                    ${item.name}
                                </div>

                                <div class="mini-cart-item-meta">
                                    تعداد: ${item.quantity}
                                </div>

                            </div>

                            <div class="mini-cart-item-price">
                                ${formatMoney(item.subtotal)}
                            </div>

                        </div>
                    `;

                }).join("");

        }

        total.textContent =
            formatMoney(data.total);

        updateCartBadges(data.count);

    }catch(error){

        console.error(
            "Mini cart error:",
            error
        );

    }

}


function updateCartBadges(count){

    document
        .querySelectorAll(
            "[data-cart-count]"
        )
        .forEach(element => {

            element.textContent = count;

        });

}


function openMiniCart(){

    document
        .getElementById("miniCart")
        .classList.add("open");

    document
        .getElementById("miniCartOverlay")
        .classList.add("open");

    refreshMiniCart();

}


function closeMiniCart(event){

    if(
        event &&
        event.target !== event.currentTarget
    ){

        return;

    }

    document
        .getElementById("miniCart")
        .classList.remove("open");

    document
        .getElementById("miniCartOverlay")
        .classList.remove("open");

}


function showMiniCartToast(){

    const toast =
        document.getElementById(
            "miniCartToast"
        );

    toast.classList.add("show");

    setTimeout(() => {

        toast.classList.remove("show");

    }, 1800);

}


async function addToMiniCart(productId){

    try{

        const response =
            await fetch(
                `/api/cart/add/${productId}`,
                {
                    method:"POST",
                    headers:{
                        "Content-Type":
                            "application/json"
                    }
                }
            );

        const data =
            await response.json();

        if(!data.ok){

            alert(
                data.message ||
                "خطایی رخ داد."
            );

            return;

        }

        showMiniCartToast();

        await refreshMiniCart();

        openMiniCart();

    }catch(error){

        console.error(error);

        alert(
            "ارتباط با سرور برقرار نشد."
        );

    }

}

</script>


<script>

document.addEventListener(
    "DOMContentLoaded",
    function(){

        refreshMiniCart();

    }
);

</script>

