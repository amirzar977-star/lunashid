<!DOCTYPE html>
<html lang="fa" dir="rtl">

<head>

<meta charset="UTF-8">

<meta name="viewport"
      content="width=device-width,initial-scale=1">

<title>{{ site.site_name }}</title>

<link rel="stylesheet"
      href="{{ url_for('static',filename='css/style.css') }}">

{% if site.background %}
<style>
.background{
    background-image:
        linear-gradient(
            rgba(247,243,234,.10),
            rgba(247,243,234,.10)
        ),
        url("{{ url_for('static',filename='uploads/backgrounds/' ~ site.background) }}");

    background-size:cover;
    background-position:center;
    background-repeat:no-repeat;
    background-attachment:fixed;
}
</style>
{% endif %}

<style>

.header-cart-button{
    position:relative;

    display:inline-flex;
    align-items:center;
    justify-content:center;
    gap:8px;

    border:1px solid rgba(255,255,255,.45);
    border-radius:999px;

    padding:10px 15px;

    background:rgba(255,255,255,.16);

    color:inherit;

    backdrop-filter:
        blur(14px)
        saturate(150%);

    -webkit-backdrop-filter:
        blur(14px)
        saturate(150%);

    cursor:pointer;

    transition:
        transform .2s ease,
        background .2s ease,
        box-shadow .2s ease;
}

.header-cart-button:hover{
    transform:translateY(-2px);

    background:rgba(255,255,255,.28);

    box-shadow:
        0 10px 30px rgba(0,0,0,.08);
}

.header-cart-icon{
    font-size:16px;
}

.header-cart-button .cart-count{
    min-width:21px;
    height:21px;

    display:inline-flex;
    align-items:center;
    justify-content:center;

    padding:0 5px;

    border-radius:999px;

    background:#A91D3A;
    color:#fff;

    font-size:11px;
    font-weight:800;
}

</style>
</head>

<body>

<div class="background"></div>

<header class="glass header">

    <a class="brand" href="{{ url_for('home') }}">

        <span class="brand-mark">ل</span>

        <span>
            <b>{{ site.site_name }}</b>
            <small>ceramic studio</small>
        </span>

    </a>

    <nav>

        <a href="{{ url_for('home') }}">
            خانه
        </a>

        <a href="{{ url_for('products') }}">
            مجموعه
        </a>

        <a href="{{ url_for('about') }}">
            درباره ما
        </a>

        <a href="{{ url_for('cart') }}">
            سبد خرید
        </a>

    <a href="{{ url_for('track_order') }}">
    پیگیری سفارش
</a>
</nav>
<button
    type="button"
    class="header-cart-button"
    onclick="openMiniCart()"
    aria-label="سبد خرید"
>
    <span class="header-cart-icon">🛒</span>
    <span>سبد خرید</span>
    <span
        class="cart-count"
        data-cart-count
    >{{ cart_count }}</span>
</button>

    <a class="mini-button"
       href="{{ url_for('products') }}">
        مشاهده مجموعه
    </a>

</header>

{% with messages=get_flashed_messages(with_categories=true) %}

{% for category,message in messages %}

<div class="toast">
    {{ message }}
</div>

{% endfor %}

{% endwith %}

{% block content %}{% endblock %}

<footer class="footer glass">

    <div>
        <b>{{ site.site_name }}</b>
        <p>{{ site.site_description }}</p>
    </div>

    <span>
        ساخته‌شده با دست · با عشق
    </span>

</footer>

<script src="{{ url_for('static',filename='js/app.js') }}"></script>


</html>










